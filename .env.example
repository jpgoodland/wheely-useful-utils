# ==============================================================================
# Wheely Useful Utils! — Environment Variables Configuration Template
# Copy this file to `.env.local` for local development.
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
APP_DOMAIN=localhost:3000
FORCE_HTTPS=false

# Authentication & Session Security
# Required: 32+ character high-entropy random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long

# Administrative RBAC
# Comma-separated list of email addresses granted administrator privileges
ADMIN_EMAILS=admin@example.com

# AWS & DynamoDB Configuration
# For local development with DynamoDB Local:
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_USERS=wheel-app-users
DYNAMODB_TABLE_WHEELS=wheel-app-wheels

# Email Service (AWS SES)
SES_FROM_EMAIL=noreply@example.com

# OAuth Authentication Providers (Optional)
# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD) OAuth & Verified Publisher
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=common
MICROSOFT_ASSOCIATION_APP_ID=

# Mock OAuth Sandbox (Enabled automatically in development when provider keys are omitted)
# OAUTH_MOCK=true
